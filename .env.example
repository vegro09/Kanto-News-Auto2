# Kanto Automator Engine - SaaS Environment Configuration

# Backend Server Port
PORT=5000

# Google Gemini API Key (Required for AI Summarization)
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Automation Schedule (24-hour HH:mm format, e.g. 07:00)
SCHEDULED_TIME=07:00

# Comma-separated search / RSS URLs
SEARCH_URLS=https://news.ycombinator.com/rss,https://www.theverge.com/rss/index.xml

# Custom AI Prompt Instruction for Arabic summarization
PROMPT_INSTRUCTIONS="قم بتلخيص أهم الأخبار والبيانات في موجز صباحي تقني موجز ومركّز. رتّب النقاط حسب الأهمية في مجالات الذكاء الاصطناعي، البنية التحتية، وتطوير البرمجيات."

# Google OAuth2 & Gmail API Credentials
# Create these in Google Cloud Console with scope https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Automatically populated when user clicks "Sign in with Google" with offline consent:
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=
